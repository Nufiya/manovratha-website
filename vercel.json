{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/static",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "manovratha.in"
        }
      ],
      "destination": "https://www.manovratha.in/:path*",
      "permanent": true
    }
  ]
}
